# ===== 应用基础 =====
APP_NAME=ai-api-service
APP_ENV=dev                        # dev / test / prod
DEBUG=true
SECRET_KEY=please-change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 数据库（PostgreSQL） =====
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_pass_123456
POSTGRES_DB=ai_api
POSTGRES_HOST=db                   # docker-compose 内部服务名；本地跑填 127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ai_user:ai_pass_123456@db:5432/ai_api

# ===== Redis =====
REDIS_URL=redis://redis:6379/0     # docker-compose 内部服务名；本地跑填 redis://127.0.0.1:6379/0

# ===== 大模型（OpenAI 兼容多 Provider，切换供应商只需改这4个变量） =====
# 可选示例：
#   DeepSeek : https://api.deepseek.com/v1   模型 deepseek-chat
#   通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   豆包     : https://ark.cn-beijing.volces.com/api/v3  模型 你的推理接入点ID
#   OpenAI   : https://api.openai.com/v1  模型 gpt-4o-mini
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# ===== 限流（Redis 实现） =====
LLM_RATE_LIMIT_PER_MINUTE=5
LLM_RATE_LIMIT_PER_DAY=200

# ===== 输入限制 =====
MAX_INPUT_LENGTH=20000              # 摘要/翻译输入最大字符数

# ===== 服务端口 =====
APP_PORT=8000
